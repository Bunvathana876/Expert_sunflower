# ==============================================================================
# Sunflower Expert System — Production & Staging Environment Template
#
# Instructions:
# 1. Copy this file to `.env.prod` or `.env.staging` on the deployment host:
#      cp .env.prod.example .env.prod
# 2. Generate cryptographically strong random secrets for all required tokens:
#      openssl rand -hex 32  # for JWT_SECRET and METRICS_SECRET_KEY
#      openssl rand -hex 24  # for POSTGRES_PASSWORD
#      openssl rand -hex 16  # for ADMIN_PASSWORD
# 3. Restrict host permissions immediately:
#      chmod 600 .env.prod
# 4. NEVER commit or push populated `.env.prod` files to Git!
# ==============================================================================

# ---- Deployment & Environment ----
ENV=production
LOG_LEVEL=INFO

# ---- PostgreSQL Database (Internal Network Only; No Public Exposure) ----
POSTGRES_USER=sunflower_app
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
# Staging recommendation: sunflower_staging_db
# Production recommendation: sunflower_prod_db
POSTGRES_DB=sunflower_prod_db

# ---- Cryptographic Authentication & JWT Secret ----
# MUST be at least 32 bytes (256 bits) for HS256 (RFC 7518).
# Startup fails loudly in production if placeholder strings are used.
JWT_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE
JWT_ALG=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ---- Default Administrator Account (Used for Initial Seeding) ----
ADMIN_EMAIL=admin@sunflower.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_STRONG_ADMIN_PASSWORD_HERE

# ---- Reverse Proxy, Domain & Automated ACME TLS ----
DOMAIN=diagnosis.sunflower.org
ACME_EMAIL=ops@sunflower.org
# For staging test certificates: https://acme-staging-v02.api.letsencrypt.org/directory
# For production trusted certificates: https://acme-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ---- Security & Hardening ----
COOKIE_SECURE=true
CSRF_REQUIRE_TOKEN=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
# Minimal verified trust boundary: Docker edge network and local loopback
TRUSTED_PROXY_IPS=172.28.2.0/24,127.0.0.1/32
# Restricted Metrics API Key (Required for scraping /health/metrics from outside loopback)
METRICS_SECRET_KEY=GENERATE_32_BYTE_HEX_SECRET_HERE

# ---- CORS & Frontend URL ----
# Empty by default because Nginx/Caddy proxies frontend and API under the same origin
CORS_ORIGINS=

# ---- Local Media Storage ----
MEDIA_BACKEND=local
MEDIA_ROOT=/var/lib/sunflower/media
MEDIA_PUBLIC_URL=/media
MEDIA_MAX_BYTES=5242880

# ---- Optional AI & LLM Inference (Ollama) ----
AI_ENABLED=true
OLLAMA_HOST=http://host.docker.internal:11434
